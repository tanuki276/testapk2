<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/core_background"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SCRIPT LAB  /  H5GG STYLE"
        android:textColor="@color/accent_cyan"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="HTML/JS-inspired local console · SAFE SANDBOX"
        android:textColor="@color/core_text_secondary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/script_path_display"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="10dp"
        android:background="@color/core_surface"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="SCRIPT  ·  [DEMO READY]"
        android:textColor="@color/core_text_secondary"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/script_editor"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_marginTop="8dp"
        android:background="@color/core_surface"
        android:fontFamily="monospace"
        android:gravity="top|start"
        android:hint="log('hello');\nsearch('100', 'I32');"
        android:inputType="textMultiLine|textNoSuggestions"
        android:padding="10dp"
        android:textColor="@color/core_text_primary"
        android:textColorHint="@color/core_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/script_console_output"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="@color/core_surface"
        android:fontFamily="monospace"
        android:padding="10dp"
        android:textColor="@color/core_text_primary"
        android:textSize="11sp"
        android:text="[READY] Local sandbox console\n[SAFE] No external process access\n> _" />

    <Button
        android:id="@+id/select_script_button"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:text="LOAD DEMO SCRIPT"
        android:background="@color/core_surface_2"
        android:textColor="@color/core_text_primary" />

    <Button
        android:id="@+id/execute_script_button"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:text="RUN SANDBOX"
        android:background="@color/accent_cyan"
        android:textColor="@color/core_background"
        android:textStyle="bold" />
</LinearLayout>
