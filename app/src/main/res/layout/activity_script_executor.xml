<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/core_background"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SCRIPT LAB / LUA"
        android:textColor="@color/accent_cyan"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Lua script runner · floating menu integration"
        android:textColor="@color/core_text_secondary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/script_path_display"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="10dp"
        android:background="@color/core_surface"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="LUA  ·  [NO FILE SELECTED]"
        android:textColor="@color/core_text_secondary"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/script_editor"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="8dp"
        android:background="@color/core_surface"
        android:fontFamily="monospace"
        android:gravity="top|start"
        android:hint="gg.setVisible(false)\nlocal menu = gg.choice({'Option 1','Option 2'}, nil, 'Menu')"
        android:inputType="textMultiLine|textNoSuggestions"
        android:padding="10dp"
        android:textColor="@color/core_text_primary"
        android:textColorHint="@color/core_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/script_console_output"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="@color/core_surface"
        android:fontFamily="monospace"
        android:padding="10dp"
        android:textColor="@color/core_text_primary"
        android:textSize="11sp"
        android:text="[READY] Lua engine\n[UI] Floating icon linked\n> _" />

    <Button
        android:id="@+id/select_script_button"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:text="LOAD LUA FILE"
        android:background="@color/core_surface_2"
        android:textColor="@color/core_text_primary" />

    <Button
        android:id="@+id/execute_script_button"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:text="RUN LUA"
        android:background="@color/accent_cyan"
        android:textColor="@color/core_background"
        android:textStyle="bold" />
</LinearLayout>
