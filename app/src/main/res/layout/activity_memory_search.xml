<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/core_background"
    android:padding="12dp">

    <TextView
        android:id="@+id/memory_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SEARCH"
        android:textColor="@color/accent_cyan"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/memory_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Known, range and unknown-value search · synthetic memory only"
        android:textColor="@color/core_text_secondary"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/search_value_input"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:hint="Value (100) or range (100~200)"
        android:textColorHint="@color/core_text_secondary"
        android:textColor="@color/core_text_primary"
        android:background="@color/core_surface"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:inputType="text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/data_type_spinner"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:entries="@array/data_types"
            android:background="@color/core_surface_2" />

        <Spinner
            android:id="@+id/search_type_spinner"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.25"
            android:background="@color/core_surface_2"
            android:entries="@array/search_types" />
    </LinearLayout>

    <Button
        android:id="@+id/search_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="NEW SEARCH"
        android:background="@color/accent_cyan"
        android:textColor="@color/core_background"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RESULTS · tap to edit · long-press to save"
            android:textColor="@color/core_text_secondary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/result_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/accent_amber"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ListView
        android:id="@+id/results_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:divider="@color/core_border"
        android:dividerHeight="1dp"
        android:background="@color/core_surface" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/refine_filter_spinner"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.25"
            android:background="@color/core_surface_2"
            android:entries="@array/refine_filters" />

        <Button
            android:id="@+id/refine_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.75"
            android:text="REFINE"
            android:background="@color/core_surface_2"
            android:textColor="@color/core_text_primary" />

        <Button
            android:id="@+id/freeze_dump_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:text="FREEZE"
            android:background="@color/core_surface_2"
            android:textColor="@color/accent_amber" />
    </LinearLayout>
</LinearLayout>
