<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/core_surface"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TITAN CORE / CONTROL"
        android:textColor="@color/accent_cyan"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.12" />

    <TextView
        android:id="@+id/process_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/status_injection_ok"
        android:textSize="13sp"
        android:textStyle="bold"
        android:text="SANDBOX READY" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:background="@color/core_border" />

    <Button
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="01  SCRIPT LAB"
        android:onClick="onScriptSelectClicked"
        android:background="@color/core_surface_2"
        android:textColor="@color/core_text_primary"
        android:gravity="start|center_vertical"
        android:paddingStart="14dp"
        android:layout_marginBottom="8dp" />

    <Button
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="02  MEMORY LAB"
        android:onClick="onMemorySearchClicked"
        android:background="@color/core_surface_2"
        android:textColor="@color/core_text_primary"
        android:gravity="start|center_vertical"
        android:paddingStart="14dp"
        android:layout_marginBottom="8dp" />

    <Button
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="03  CLOSE CONSOLE"
        android:onClick="onCloseClicked"
        android:background="@color/alert_fatal"
        android:textColor="@color/core_text_primary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="All operations are local simulations."
        android:textColor="@color/core_text_secondary"
        android:textSize="11sp" />
</LinearLayout>
