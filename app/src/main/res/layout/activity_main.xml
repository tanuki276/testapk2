<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/core_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TITAN GUARD"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp"
            android:letterSpacing="0.18"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Memory Tool Simulator"
            android:textColor="@color/core_text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="GameGuardian-style workflow recreated with synthetic in-app memory only."
            android:textColor="@color/core_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@color/core_surface"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SAFE MODE"
                android:textColor="@color/core_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="●  SYNTHETIC MEMORY ONLY"
                android:textColor="@color/accent_green"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="No root · no process attachment · no external memory access"
                android:textColor="@color/core_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Like the reference app, Start creates a draggable floating icon. Tap it to open Search, Saved and Lua tools."
            android:textColor="@color/core_text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/start_overlay_button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:background="@color/accent_cyan"
            android:onClick="onStartOverlayClicked"
            android:text="START FLOATING TOOL"
            android:textColor="@color/core_background"
            android:textStyle="bold" />

        <Button
            android:id="@+id/open_panel_button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@color/core_surface_2"
            android:onClick="onOpenPanelClicked"
            android:text="OPEN TOOL PANEL"
            android:textColor="@color/core_text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Simulation build · values and addresses exist only inside this app"
            android:textColor="@color/core_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
